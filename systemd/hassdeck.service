[Unit]
Description=hassdeck (deck USB per Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hassdeck
Group=hassdeck
# Per leggere la tensione di alimentazione con vcgencmd (/dev/vcio_gencmd).
SupplementaryGroups=video
WorkingDirectory=/opt/hassdeck
ExecStart=/opt/hassdeck/target/release/hassdeck /opt/hassdeck/config.toml
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# Hardening: il servizio scrive solo config.toml e icons/
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/hassdeck/config.toml /opt/hassdeck/icons

[Install]
WantedBy=multi-user.target
